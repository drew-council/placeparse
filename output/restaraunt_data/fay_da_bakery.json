  "reviews": [
    {
      "author_name": "Drew Bear",
      "author_url": "https://www.google.com/maps/contrib/108878446580262806788/reviews",
      "language": "en",
      "original_language": "en",
      "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjU48fLqvi0LSCxpwzdp3e8tbA4uMR9I4oveVhIdPMKtSXDZ6ptF=s128-c0x00000000-cc-rp-mo-ba5",
      "rating": 5,
      "relative_time_description": "a year ago",
      "text": "Staff moves with efficiency and very nice, everything I had was delish and the price is great for bakery items, I hope it never changes 🥹. I really wanted to go back in for more.  Next time!💘\nThere is a $10 minimum for cards. Cash is better if you don't want too much but you can get a satisfying snack or meal for that minimum.  The chicken bun  I had was 👍👍👍 coffee milk tea was warming and you can adjust Sweetness.. I wanna try the Harlick and tofu flower drink as well as the soy milk.",
      "time": 1713271232,
      "translated": false
    },
    {
      "author_name": "Terri Arabie",
      "author_url": "https://www.google.com/maps/contrib/101952226361031998180/reviews",
      "language": "en",
      "original_language": "en",
      "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocJsRF_6a7ErO4tSgeWhjmywg5titodh3uaqxQwLBLYK1-iQ1Q=s128-c0x00000000-cc-rp-mo-ba2",
      "rating": 5,
      "relative_time_description": "in the last week",
      "text": "Amazing bakery!  I travel from Westchester to enjoy the coffee and desserts.  The service is quick and the patrons are polite.  It is the best bakery!",
      "time": 1750810472,
      "translated": false
    },
    {
      "author_name": "Julia Li",
      "author_url": "https://www.google.com/maps/contrib/102160056046975740457/reviews",
      "language": "en",
      "original_language": "en",
      "profile_photo_url": "https://lh3.googleusercontent.com/a-/ALV-UjW48FniAypn6ONDkQXXS_bHtIS3ms7qRewyUmKq_oqi0NTuwolN=s128-c0x00000000-cc-rp-mo-ba4",
      "rating": 5,
      "relative_time_description": "2 years ago",
      "text": "PHENOMENAL! Such an authentic Chinese bakery and everything’s so cheap!! Highly recommend their soy milk (only $2.75 for 20 oz) and pork floss bun!!\nThe bun is so soft and fluffy and the soy milk is super fresh🕺 egg tart was ok, feel like it was slightly under baked",
      "time": 1666278551,
      "translated": false
    },
    {
      "author_name": "Anna Trecker",
      "author_url": "https://www.google.com/maps/contrib/111252759883023959428/reviews",
      "language": "en",
      "original_language": "en",
      "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocLWBNU8cCEtbpo6yZ4iheMLxAFqqdv16ugRfncBvDyrUe9dkw=s128-c0x00000000-cc-rp-mo",
      "rating": 5,
      "relative_time_description": "a month ago",
      "text": "Most delicious Taiwanese desserts at very affordable prices. I’ve gotten multiple catering orders and the staff always help carry it out. Thank you Fay Da!",
      "time": 1746201480,
      "translated": false
    },
    {
      "author_name": "James Finley",
      "author_url": "https://www.google.com/maps/contrib/111096052014736653622/reviews",
      "language": "en",
      "original_language": "en",
      "profile_photo_url": "https://lh3.googleusercontent.com/a/ACg8ocLq1a_Xap2_5oy3vENZq_7GpKyE1wMH3u_Ibu0PSxnHHwg-Xw=s128-c0x00000000-cc-rp-mo-ba3",
      "rating": 5,
      "relative_time_description": "10 months ago",
      "text": "They are so nice here! I ordered incorrectly and she redid it for no charge. Been a fan for a long time. That just made me want to jump in and leave my thanks!",
      "time": 1722699450,
      "translated": false
    }
  ],
